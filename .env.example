# Copie para .env.local (nunca versionar valores reais de chaves privadas).
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# desenvolvimento | producao
NEXT_PUBLIC_APP_ENV=desenvolvimento
# Área do aluno (servidor): chave interna para a função "vitrine" aceitar o IP do comprador (mesmo valor no
# audita-functions). Só no servidor; nunca NEXT_PUBLIC. Opcional no desenvolvimento.
VITRINE_CHAVE_INTERNA=

# Somente para testes de integração no ambiente de DESENVOLVIMENTO (usuários fictícios):
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_INTRUSO_EMAIL=
TEST_INTRUSO_PASSWORD=
