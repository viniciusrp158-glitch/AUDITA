#!/bin/sh
# Backup diário do Sistema AUDITA na VPS 1 (adaptado de deploy/vps/audita-sistema-backup.sh): banco completo (inclui
# auth), Storage, .env do Supabase e web.env do site. Mantém 14 dias em ~/backups/audita-sistema. Cron do usuário deploy.
set -e
umask 077
D=$HOME/backups/audita-sistema; T=$(date +%F_%H%M); mkdir -p $D
docker exec audita-db pg_dumpall -U supabase_admin --clean --if-exists | gzip -9 > $D/db_$T.sql.gz
docker exec audita-storage tar -czf - -C /var/lib storage > $D/storage_$T.tar.gz
cp $HOME/audita/supabase-audita/.env $D/env_$T
cp $HOME/audita/audita-sistema/web.env $D/web-env_$T
find $D -maxdepth 1 -type f -mtime +14 -delete
echo "$(date -Is) ok $(du -sh $D | cut -f1)" >> $HOME/backups/audita-sistema-backup.log
